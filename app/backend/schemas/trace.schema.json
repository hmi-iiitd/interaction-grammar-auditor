{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interaction Trace v1.0",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "timestamp", "agent", "event_type", "primitive", "modality"],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^e[0-9]{3,}$",
            "description": "Unique event identifier, e.g. e001"
          },
          "timestamp": {
            "type": "number",
            "minimum": 0,
            "description": "Relative timestamp in seconds from start of interaction"
          },
          "agent": {
            "type": "string",
            "description": "Agent identifier, e.g. robot_1, human_1"
          },
          "event_type": {
            "type": "string",
            "description": "Human-readable event type, e.g. prompt, ack, confirm, speaking_start"
          },
          "primitive": {
            "type": "string",
            "enum": ["σ", "ρ", "τ", "α"],
            "description": "IG primitive: σ=start, ρ=end, τ=point, α=abstract"
          },
          "modality": {
            "type": "string",
            "description": "Interaction channel, e.g. speech, gesture, gaze"
          },
          "object": {
            "type": ["string", "null"],
            "description": "Optional object/reference for the event"
          },
          "source_topic": {
            "type": ["string", "null"],
            "description": "ROS topic source, if available"
          },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "Detection confidence, if available"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
